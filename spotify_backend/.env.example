# Amplify Backend — Environment Variables
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
#
# .gitignore already includes .env — double-check before deploying.

# ─── Core ────────────────────────────────────────────────────────────────────

MONGO_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/amplify?retryWrites=true&w=majority
JWT_SECRET=your_random_jwt_secret_at_least_32_characters

# ─── OAuth Token Encryption ──────────────────────────────────────────────────
# AES-256 key for encrypting Spotify/YouTube tokens stored in MongoDB.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── Spotify Integration ─────────────────────────────────────────────────────
# Create an app at: https://developer.spotify.com/dashboard
#
# Required settings in the Spotify Dashboard:
#   Redirect URI: https://amplifysaas.onrender.com/api/import/spotify/callback
#   (Add localhost equivalent for local dev: http://localhost:5000/api/import/spotify/callback)
#
# Required scopes (configured server-side, not needed here):
#   user-library-read, playlist-read-private, playlist-read-collaborative
#   user-read-recently-played, user-top-read, user-read-private, user-read-email

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://amplifysaas.onrender.com/api/import/spotify/callback

# ─── Google / YouTube Integration ────────────────────────────────────────────
# Create OAuth 2.0 credentials at: https://console.cloud.google.com/
# Enable: YouTube Data API v3
#
# Required settings in Google Cloud Console:
#   Authorized redirect URI: https://amplifysaas.onrender.com/api/import/youtube/callback
#
# Required scopes:
#   https://www.googleapis.com/auth/youtube.readonly
#   https://www.googleapis.com/auth/userinfo.profile
#   https://www.googleapis.com/auth/userinfo.email

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://amplifysaas.onrender.com/api/import/youtube/callback
# Optional: Server-side API key for YouTube Data API quota management
GOOGLE_API_KEY=

# ─── Google Sign-In (existing — for Amplify native login) ────────────────────
GOOGLE_WEB_CLIENT_ID=
